.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 60px; /* 改为与首页一致的px单位 */
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 20rpx;
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.welcome {
  font-size: 24rpx;
  opacity: 0.9;
}

.login-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50rpx;
  padding: 15rpx 30rpx;
  font-size: 28rpx;
}

/* 功能列表 */
.func-list {
  margin-top: 20rpx;
}

.list-section {
  background-color: #fff;
  margin-bottom: 20rpx;
  border-radius: 15rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.list-item:last-child {
  border-bottom: none;
}

.item-text {
  font-size: 32rpx;
  color: #333;
}

.item-desc {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

.item-arrow {
  color: #ccc;
  font-size: 28rpx;
}

/* 底部导航栏样式 - 与首页完全一致 */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px; /* 改为与首页一致的px单位 */
  background: #fff;
  display: flex;
  border-top: 1px solid #e0e0e0; /* 改为与首页一致的px单位 */
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  padding: 8px 0; /* 改为与首页一致的px单位 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  font-size: 20px; /* 改为与首页一致的px单位 */
  margin-bottom: 4px; /* 改为与首页一致的px单位 */
}

.tab-text {
  font-size: 12px; /* 改为与首页一致的px单位 */
  color: #666;
}

/* 选中状态样式 - 与首页完全一致 */
.tab-bar-item.active .tab-text {
  color: #007aff; /* 选中时颜色变深 */
  font-weight: bold;
}

.tab-bar-item.active .tab-icon {
  opacity: 1;
}

.tab-bar-item:not(.active) .tab-icon {
  opacity: 0.6;
}


