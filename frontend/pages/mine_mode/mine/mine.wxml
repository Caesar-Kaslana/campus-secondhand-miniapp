<view class="page-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-meta">
        <text class="nickname">{{userInfo.nickName || '您好，请登录'}}</text>
        <text class="welcome">欢迎回来</text>
      </view>
    </view>
    <button wx:if="{{!hasUserInfo}}" class="login-btn" bindtap="navigateToLogin">登录</button>
  </view>

  <!-- 功能列表 -->
  <view class="func-list">
    <view class="list-section">
      <!-- 更新订单页面路径 -->
      <view class="list-item" bindtap="navigateTo" data-url="/pages/mine_mode/mine_orders/orders?type=all">
        <text class="item-text">我的订单</text>
        <text class="item-desc">查看全部订单</text>
        <view class="item-arrow">></view>
      </view>
      <view class="list-item" bindtap="navigateTo" data-url="/pages/favorite/favorite">
        <text class="item-text">我的收藏</text>
        <view class="item-arrow">></view>
      </view>
    </view>

    <view class="list-section">
      <view class="list-item" bindtap="navigateTo" data-url="/pages/address/address">
        <text class="item-text">收货地址</text>
        <view class="item-arrow">></view>
      </view>
      <view class="list-item" bindtap="contactCustomerService">
        <text class="item-text">联系客服</text>
        <view class="item-arrow">></view>
      </view>
    </view>

    <view class="list-section">
      <view class="list-item" bindtap="navigateToSettings" data-url="/pages/mine_mode/mine_setting/mine_setting">
        <text class="item-text">设置</text>
        <view class="item-arrow">></view>
      </view>
      <view class="list-item" bindtap="navigateTo" data-url="/pages/mine_mode/about/about">
        <text class="item-text">关于我们</text>
        <view class="item-arrow">></view>
      </view>
    </view>
  </view>

  <!-- 自定义底部导航栏 - 与首页保持一致 -->
  <view class="custom-tab-bar">
    <view 
      class="tab-bar-item {{currentTab === 0 ? 'active' : ''}}" 
      data-index="0" 
      bindtap="switchTab"
    >
      <view class="tab-icon">🏠</view>
      <text class="tab-text">首页</text>
    </view>
    
    <view 
      class="tab-bar-item {{currentTab === 1 ? 'active' : ''}}" 
      data-index="1" 
      bindtap="switchTab"
    >
      <view class="tab-icon">➕</view>
      <text class="tab-text">发布</text>
    </view>
    
    <view 
      class="tab-bar-item {{currentTab === 2 ? 'active' : ''}}" 
      data-index="2" 
      bindtap="switchTab"
    >
      <view class="tab-icon">👤</view>
      <text class="tab-text">我的</text>
    </view>
  </view>
</view>
