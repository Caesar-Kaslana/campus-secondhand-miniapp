/* pages/settings/settings.wxss */
.settings-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-section {
  width: 80%;
}

.logout-btn {
  width: 100%;
  height: 90rpx;
  background: #ff4757;
  color: white;
  border: none;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
}
.logout-btn:active {
  background: #ff3742;
  opacity: 0.9;
}